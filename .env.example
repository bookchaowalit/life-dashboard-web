# Local demo must be explicitly enabled and is disabled unconditionally in production.
SOLO_WEB_LOCAL_DEMO=false
# Hosted origins: exact HTTPS origin only. Comma-separated preview origins, no wildcards.
SOLO_WEB_PUBLIC_ORIGIN=
SOLO_WEB_PREVIEW_ORIGINS=
# OIDC confidential client; register /api/auth/callback on every permitted origin.
SOLO_WEB_OIDC_ISSUER=
SOLO_WEB_OIDC_CLIENT_ID=
SOLO_WEB_OIDC_CLIENT_SECRET=
# JSON array of exact OIDC sub values; no email-based authorization.
SOLO_WEB_OWNER_SUBJECTS=[]
# Secret: 32 random bytes encoded as unpadded base64url, configured outside Git.
SOLO_WEB_SESSION_KEY=
# Secret: RS256 PKCS8 PEM private key, configured outside Git. Backends get public PEM only.
SOLO_WEB_SERVICE_PRIVATE_KEY=

# These defaults are local only. Production must explicitly configure HTTPS origins.
# Each remote destination also needs its <SERVICE>_ALLOW_REMOTE=true flag below.
TODAY_API_ORIGIN=http://127.0.0.1:3410
KNOWLEDGE_API_ORIGIN=http://127.0.0.1:3430
CLOUD_API_ORIGIN=http://127.0.0.1:3440
PRODUCTION_HUB_API_ORIGIN=http://127.0.0.1:3460
ACCOUNTS_API_ORIGIN=http://127.0.0.1:3470
INTEGRATIONS_API_ORIGIN=http://127.0.0.1:3480
SAAS_CATALOG_API_ORIGIN=http://127.0.0.1:3490
TODAY_API_ALLOW_REMOTE=false
KNOWLEDGE_API_ALLOW_REMOTE=false
CLOUD_API_ALLOW_REMOTE=false
PRODUCTION_HUB_API_ALLOW_REMOTE=false
ACCOUNTS_API_ALLOW_REMOTE=false
INTEGRATIONS_API_ALLOW_REMOTE=false
SAAS_CATALOG_API_ALLOW_REMOTE=false
# Legacy token: only sent to loopback in explicitly enabled nonproduction demo mode.
PRODUCTION_HUB_API_TOKEN=
