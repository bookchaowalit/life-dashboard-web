# Each module's backend has its own origin so it can be moved or scaled independently.
# Non-loopback origins must be HTTPS and need <SERVICE>_ALLOW_REMOTE=true.
TODAY_API_ORIGIN=http://127.0.0.1:3410
KNOWLEDGE_API_ORIGIN=http://127.0.0.1:3430
CLOUD_API_ORIGIN=http://127.0.0.1:3440
PRODUCTION_HUB_API_ORIGIN=http://127.0.0.1:3460
# Server-side only; sent on Production mutations when the hub API requires a token.
PRODUCTION_HUB_API_TOKEN=
